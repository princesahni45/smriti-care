rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Authentication & Role Helpers ─────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role comes from users/{uid}.role or auth custom claims.
    // Document existence guard prevents runtime rule evaluation failures.
    function userRole() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isCaregiver() {
      return isAuthenticated() && (
        request.auth.token.role == 'caregiver' ||
        userRole() == 'caregiver'
      );
    }

    function isDoctor() {
      return isAuthenticated() && (
        request.auth.token.role == 'doctor' ||
        userRole() == 'doctor'
      );
    }

    function isMedicalStaff() {
      return isCaregiver() || isDoctor();
    }

    // Cryptographic patient session binding: verifies that an anonymous UID
    // was linked to a specific patient ID through a validated access code.
    function isVerifiedPatient(targetPatientId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/patientSessions/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/patientSessions/$(request.auth.uid)).data.patientId == targetPatientId;
    }

    // Assigned Caregiver verification: verifies that the authenticated caregiver
    // is specifically assigned to targetPatientId in patients/{patientId} or caregivers/{uid}/patients/{patientId}.
    function isAssignedCaregiver(patientId) {
      return isCaregiver() && (
        (exists(/databases/$(database)/documents/patients/$(patientId)) &&
         (get(/databases/$(database)/documents/patients/$(patientId)).data.caregiverId == request.auth.uid ||
          (request.auth.token.email != null && get(/databases/$(database)/documents/patients/$(patientId)).data.caregiverId == request.auth.token.email))) ||
        exists(/databases/$(database)/documents/caregivers/$(request.auth.uid)/patients/$(patientId)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/caregivers/$(request.auth.token.email)/patients/$(patientId)))
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // User Profiles: users/{userId}
    // Provisioned strictly via Admin SDK / Backend. Client mutations disabled.
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isUser(userId) || isDoctor();
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Patient Sessions: patientSessions/{sessionUid}
    // Maps Firebase Anonymous UIDs to verified patient identities.
    // CREATE-ONLY: Immutable once written. Atomic mutual binding with code update.
    // ─────────────────────────────────────────────────────────────────────────
    match /patientSessions/{sessionUid} {
      allow read: if isAuthenticated() && (
        request.auth.uid == sessionUid ||
        isMedicalStaff()
      );

      // A client may only bind their own anonymous UID to a patient if they
      // supply a valid, active, unexpired, unlinked access code in the SAME atomic batch.
      allow create: if isAuthenticated()
        && request.auth.uid == sessionUid
        && request.resource.data.anonymousUid == sessionUid
        && request.resource.data.patientId is string
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/patientAccessCodes/$(request.resource.data.code))
        // Code must be active
        && get(/databases/$(database)/documents/patientAccessCodes/$(request.resource.data.code)).data.isActive == true
        // Code must NOT have been linked prior to this atomic write
        && get(/databases/$(database)/documents/patientAccessCodes/$(request.resource.data.code)).data.isLinked != true
        // Code must not be expired
        && (!('expiresAtTimestamp' in get(/databases/$(database)/documents/patientAccessCodes/$(request.resource.data.code)).data) ||
            get(/databases/$(database)/documents/patientAccessCodes/$(request.resource.data.code)).data.expiresAtTimestamp > request.time)
        // PatientId in session must match patientId in code
        && get(/databases/$(database)/documents/patientAccessCodes/$(request.resource.data.code)).data.patientId == request.resource.data.patientId
        // Atomic mutual binding: code must be marked isLinked=true with linkedUid=sessionUid in this batch
        && getAfter(/databases/$(database)/documents/patientAccessCodes/$(request.resource.data.code)).data.isLinked == true
        && getAfter(/databases/$(database)/documents/patientAccessCodes/$(request.resource.data.code)).data.linkedUid == sessionUid;

      // STRICT IMMUTABILITY: Sessions can never be rebound or updated
      allow update: if false;
      allow delete: if isAuthenticated() && (request.auth.uid == sessionUid || isCaregiver());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Patient Access Codes: patientAccessCodes/{code}
    // ─────────────────────────────────────────────────────────────────────────
    match /patientAccessCodes/{code} {
      // Direct get: Strictly authorized caregivers or doctors.
      // Anonymous clients are denied direct reads to prevent PII harvesting.
      allow get: if isAuthenticated() && (
        isCaregiver() ||
        isDoctor()
      );

      // Only authenticated caregivers can search/list codes
      allow list: if isAuthenticated() && isCaregiver();

      // Only authenticated caregivers can create codes; requires valid expiresAtTimestamp
      allow create: if isAuthenticated() && isCaregiver() && (
        request.resource.data.caregiverId == request.auth.uid ||
        (request.auth.token.email != null && request.resource.data.caregiverId == request.auth.token.email)
      )
      && request.resource.data.expiresAtTimestamp is timestamp
      && request.resource.data.expiresAtTimestamp > request.time
      && request.resource.data.isActive == true
      && request.resource.data.isLinked == false;

      // Updates: Caregiver managing code OR Patient atomic linking
      allow update: if isAuthenticated() && (
        (isCaregiver() && (
          resource.data.caregiverId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.caregiverId == request.auth.token.email)
        )) ||
        (
          resource.data.isActive == true &&
          resource.data.isLinked != true &&
          (
            (resource.data.expiresAtTimestamp is timestamp && resource.data.expiresAtTimestamp > request.time) ||
            (!('expiresAtTimestamp' in resource.data) && 'expiresAt' in resource.data)
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isLinked', 'linkedAt', 'linkedUid']) &&
          request.resource.data.isLinked == true &&
          request.resource.data.linkedUid == request.auth.uid &&
          // Atomic mutual binding: patientSession document for this UID must be created in this batch
          getAfter(/databases/$(database)/documents/patientSessions/$(request.auth.uid)).data.code == code &&
          getAfter(/databases/$(database)/documents/patientSessions/$(request.auth.uid)).data.patientId == resource.data.patientId
        )
      );

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Patient Profiles & Subcollections: patients/{patientId}
    // ─────────────────────────────────────────────────────────────────────────
    match /patients/{patientId} {
      // Read: Assigned caregiver, doctor, or verified patient reading their own record
      allow read: if isAuthenticated() && (
        isDoctor() ||
        isAssignedCaregiver(patientId) ||
        isVerifiedPatient(patientId)
      );

      // Create: Caregiver assigning themselves
      allow create: if isAuthenticated() && isCaregiver() && (
        request.resource.data.caregiverId == request.auth.uid ||
        (request.auth.token.email != null && request.resource.data.caregiverId == request.auth.token.email)
      );

      // Update: Assigned caregiver only
      allow update: if isAuthenticated() && isAssignedCaregiver(patientId);

      allow delete: if false;

      // Emergency settings: No public read; restricted to assigned medical staff or verified patient
      match /emergency_settings/{document=**} {
        allow read: if isAuthenticated() && (
          isDoctor() ||
          isAssignedCaregiver(patientId) ||
          isVerifiedPatient(patientId)
        );
        allow write: if isAuthenticated() && isAssignedCaregiver(patientId);
      }

      // Activity logs
      match /activity_logs/{logId} {
        allow read: if isAuthenticated() && (isDoctor() || isAssignedCaregiver(patientId) || isVerifiedPatient(patientId));
        allow write: if isAuthenticated() && (isAssignedCaregiver(patientId) || isVerifiedPatient(patientId));
      }

      // Daily step tracking telemetry: patients/{patientId}/dailySteps/{date}
      match /dailySteps/{date} {
        allow read: if isAuthenticated() && (
          isDoctor() ||
          isAssignedCaregiver(patientId) ||
          isVerifiedPatient(patientId)
        );

        // Secure write validation: only assigned caregiver or verified patient for this patientId
        allow create, update: if isAuthenticated() && (
          isAssignedCaregiver(patientId) ||
          isVerifiedPatient(patientId)
        )
        && request.resource.data.patientId == patientId
        && request.resource.data.date == date
        && request.resource.data.steps is number
        && request.resource.data.steps >= 0
        && request.resource.data.goal is number
        && request.resource.data.goal >= 0
        && request.resource.data.updatedAt is string
        && request.resource.data.source is string
        && (resource == null || request.resource.data.steps >= resource.data.steps);

        allow delete: if isAuthenticated() && isAssignedCaregiver(patientId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Caregiver Profiles: caregivers/{caregiverId}
    // ─────────────────────────────────────────────────────────────────────────
    match /caregivers/{caregiverId} {
      // Profile get: Strictly Self or Doctor. No public or anonymous profile scraping.
      allow get: if isAuthenticated() && (
        request.auth.uid == caregiverId ||
        (request.auth.token.email != null && request.auth.token.email == caregiverId) ||
        isDoctor()
      );

      // List: Doctors or caregiver self
      allow list: if isAuthenticated() && (
        isDoctor() ||
        request.auth.uid == caregiverId ||
        (request.auth.token.email != null && request.auth.token.email == caregiverId)
      );

      allow create, update: if isAuthenticated() && isCaregiver() && (
        request.auth.uid == caregiverId ||
        (request.auth.token.email != null && request.auth.token.email == caregiverId)
      );

      allow delete: if false;

      match /patients/{patientId} {
        allow read, write: if isAuthenticated() && isCaregiver() && (
          request.auth.uid == caregiverId ||
          (request.auth.token.email != null && request.auth.token.email == caregiverId)
        );
      }

      match /linkedPatients/{patientId} {
        allow read, write: if isAuthenticated() && isCaregiver() && (
          request.auth.uid == caregiverId ||
          (request.auth.token.email != null && request.auth.token.email == caregiverId)
        );
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Caregiver Code Directory: caregiverCodeDirectory/{caregiverCode}
    // Secure minimal lookup: Only exposes caregiverId and name; no phone, email, or private data.
    // ─────────────────────────────────────────────────────────────────────────
    match /caregiverCodeDirectory/{caregiverCode} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isAuthenticated() && isCaregiver() && (
        request.resource.data.caregiverId == request.auth.uid ||
        (request.auth.token.email != null && request.resource.data.caregiverId == request.auth.token.email)
      )
      && request.resource.data.caregiverId is string
      && request.resource.data.caregiverName is string;
      allow delete: if isAuthenticated() && isCaregiver() && (
        resource.data.caregiverId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.caregiverId == request.auth.token.email)
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Patient Cognitive Game Results: patientGameResults/{resultId}
    // ─────────────────────────────────────────────────────────────────────────
    match /patientGameResults/{resultId} {
      allow read: if isAuthenticated() && (
        isDoctor() ||
        isAssignedCaregiver(resource.data.patientId) ||
        isVerifiedPatient(resource.data.patientId)
      );

      // CREATE-ONLY: Cognitive game results are immutable event records
      allow create: if isAuthenticated() && (
        isAssignedCaregiver(request.resource.data.patientId) ||
        isVerifiedPatient(request.resource.data.patientId)
      )
      && request.resource.data.patientId is string
      && request.resource.data.gameId is string
      && request.resource.data.score is number
      && request.resource.data.score >= 0
      && request.resource.data.score <= 100
      && request.resource.data.timestamp is string;

      allow update: if false; // Immutable
      allow delete: if false;
    }
  }
}
